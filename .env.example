# =============================================================================
# SmartMail AI - Environment Configuration Example
# Copy this file to .env and configure values before starting the application
# =============================================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartmail_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_URL=jdbc:mysql://localhost:3306/smartmail_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security Secret (Use minimum 256-bit secure random key)
JWT_SECRET=replace_with_a_new_random_256_bit_secret
JWT_EXPIRATION_MS=86400000

# Google Gemini API Configuration (Obtain free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend & Extension CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
